# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Backend connection string (optional; built from POSTGRES_* if empty)
DATABASE_URL=

# Service ports
BACKEND_PORT=8000
FRONTEND_PORT=80

# Frontend API URL
# Use /api when serving through Nginx on the same domain.
# For local dev outside Docker use http://localhost:8000/api
VITE_API_URL=/api
VITE_CONTACT_PHONE=+57300XXXXXXX

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seed first admin
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS origins (empty for same-domain deployments)
CORS_ORIGINS=
